                </textElement>
                <textFieldExpression><![CDATA["प्रमाणित किया जाता है कि<br/><font color='black'><b>"+$P{data}.get("naam")+"</b></font><br/>ने ईस्वी सन <font color='black'><b>"+$P{data}.get("year")+"</b></font> में इस विश्वविद्यालय के<br/>मुक्त एवं दूरवर्ती शिक्षा प्रणाली के अंतर्गत<br/><font color='black'><b>"+$P{data}.get("shikshaNaam")+"</b></font><br/>की परीक्षा <font color='black'><b>"+$P{data}.get("bhaag")+"</b></font> में उत्तीर्ण की। उन्हें<br/><font color='black'><b>"+$P{data}.get("shikshaNaam")+"</b></font><br/>की उपाधि प्रदान की जाती है।"]]></textFieldExpression>
