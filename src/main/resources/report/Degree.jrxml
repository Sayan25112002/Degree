                <textFieldExpression><![CDATA["This is to certify that <br /><font color='black'><b>"+$P{data}.get("name")+"</b></font><br />have passed the<br /><font color='black'><b>"+$P{data}.get("courseName")+"</b></font><br />Examination of this University in <br />Open and Distance Learning Mode in the year <font color='black'><b>"+$P{data}.get("year")+"</b></font><br /> in <b><font color='black'>"+$P{data}.get("division")+"</b></font><br />is admitted to the degree of <br /><b><font color='black'>"+$P{data}.get("courseName")+"</b></font>"]]></textFieldExpression>
            </textField>
